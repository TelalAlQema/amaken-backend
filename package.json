{
  "name": "@amaken/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "lint": "eslint src --ext .js",
    "clean": "rm -rf node_modules",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "node scripts/test-db.js ensure && node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:contract": "node scripts/test-db.js ensure && node --test --test-concurrency=1 \"test/contract/*.test.js\"",
    "test:db:reset": "node scripts/test-db.js reset",
    "test:db:ensure": "node scripts/test-db.js ensure",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "@amaken/shared": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "^5.15.0",
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.33.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "prisma": "^5.15.0",
    "supertest": "^7.3.0"
  }
}
