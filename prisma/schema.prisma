// Prisma Schema for Amaken Real Estate
// MySQL 8.0

generator client {
  provider = "prisma-client-js"

  // `prisma.$metrics()` throws without this, and the pool gauges in
  // `core/observability/metrics.js` read from it. Without it they sit at the 0 a
  // Gauge is born with — a "the pool is empty" reading that means only "nobody
  // looked". Enabling it is what makes `amaken_api_db_pool_*` real numbers.
  //
  // Remove this when pool metrics reach stable, and re-check those gauges still
  // populate: the failure mode is silent and looks exactly like a healthy pool.
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODELS
// ============================================================

model User {
  uid            Int     @id @default(autoincrement())
  uname          String  @db.VarChar(255)
  lname          String  @db.VarChar(255)
  uemail         String  @unique @db.VarChar(255)
  uphone         String  @db.VarChar(100)
  upass          String  @db.VarChar(255)
  utype          String  @default("User") @db.VarChar(100)
  uimage         String  @default("") @db.VarChar(255)
  date           String  @db.VarChar(50)
  dateofbirth    String? @db.VarChar(50)
  Address        String? @db.VarChar(500)
  deactivate     Int     @default(1)
  company        String? @db.VarChar(255)
  ucompanylogo   String? @db.VarChar(255)
  state          String? @db.VarChar(255)
  city           String? @db.VarChar(255)
  Companyaddress String? @db.VarChar(500)
  ugender        String? @db.VarChar(100)
  uloginvalue    Int     @default(0)
  wphone         String? @db.VarChar(100)
  fb             String? @db.VarChar(500)
  linkedin       String? @db.VarChar(500)
  tiktok         String? @db.VarChar(500)
  instagram      String? @db.VarChar(500)
  twitter        String? @db.VarChar(500)
  website        String? @db.VarChar(500)
  adminblock     Int     @default(0)
  blocked        String  @default("") @db.VarChar(100)
  linkweb        String  @default("") @db.VarChar(100)
  editprofile    String  @default("") @db.VarChar(100)
  editcomlogo    String  @default("") @db.VarChar(100)
  editpropic     String  @default("") @db.VarChar(100)
  linkpagedate   String  @default("") @db.VarChar(100)
  lastseen       String  @default("") @db.VarChar(100)
  udate          String  @default("") @db.VarChar(100)

  /// M03. Bumped whenever every outstanding token for this account must stop being
  /// accepted — today, a password reset. It rides in the `tokenVersion` claim and is
  /// checked at `/api/auth/refresh`, the only place a token is compared against its
  /// database row.
  ///
  /// Not checked per request: that buys a `SELECT user` on every authenticated call
  /// to shorten a window that is already bounded by `JWT_EXPIRES_IN` (15 minutes).
  ///
  /// The M03 plan asserted this column already existed. It did not — the only trace
  /// was an unused fourth parameter on `generateTokenPair`, which put
  /// `tokenVersion: undefined` into every token the API had ever issued, so nothing
  /// was reading it and nothing could bump it.
  tokenVersion   Int     @default(0)

  // Relations
  properties    Property[]    @relation("UserProperties")
  feedbackGiven Feedback[]    @relation("FeedbackFromUser")
  deviceTokens  DeviceToken[]
}

model Admin {
  aid             Int      @id @default(autoincrement())
  aname           String   @db.VarChar(255)
  aemail          String   @unique @db.VarChar(255)
  aphone          String   @db.VarChar(100)
  apass           String   @db.VarChar(255)
  atype           String   @db.VarChar(50)
  aimage          String   @default("") @db.VarChar(255)
  joinadate       String   @db.VarChar(50)
  audate          String   @default("") @db.VarChar(100)
  adateofbirth    String?  @db.VarChar(50)
  alname          String   @db.VarChar(255)
  aAddress        String?  @db.VarChar(500)
  awphone         String?  @db.VarChar(100)
  aeditprofile    String   @default("") @db.VarChar(100)
  adeactivate     Int      @default(0)
  agency          String?  @db.VarChar(255)
  companylogo     String?  @db.VarChar(255)
  website         String?  @map("companywebsite") @db.VarChar(500)
  afb             String?  @db.VarChar(500)
  ainstagram      String?  @db.VarChar(500)
  atwitter        String?  @db.VarChar(500)
  atiktok         String?  @db.VarChar(500)
  alinkedin       String?  @db.VarChar(500)
  aeditpropic     String   @default("") @db.VarChar(100)
  aeditcomlogo    String   @default("") @db.VarChar(100)
  astate          String?  @db.VarChar(255)
  acity           String?  @db.VarChar(255)
  acompanyAddress String?  @db.VarChar(500)
  alinkpagedate   String   @default("") @db.VarChar(100)
  agender         String?  @db.VarChar(100)
  onlinetime      String?  @db.VarChar(50)
  aloginvalue     Int      @default(0)
  adminblock      Int      @default(0)
  main            String   @default("") @db.VarChar(255)
  is_logged_in    Boolean? @default(false)
  last_session_id String?  @db.VarChar(255)

  /// M03. The admin counterpart of `User.tokenVersion`. `/api/auth/refresh`
  /// dispatches on the token's `role` claim and reads whichever table matches, so
  /// the claim has to mean the same thing on both. M04 owns the rest of the admin
  /// identity work.
  tokenVersion    Int      @default(0)

  // Relations
  properties    Property[]   @relation("AdminProperties")
  feedbackGiven Feedback[]   @relation("FeedbackFromAdmin")
  social        AdminSocial?
}

model Property {
  id             Int     @id @default(autoincrement())
  email          String  @db.VarChar(255)
  date           String  @db.VarChar(50)
  title          String  @db.VarChar(191)
  pcontent       String? @db.Text
  type           String  @db.VarChar(100)
  bhk            String  @db.VarChar(100)
  stype          String  @db.VarChar(100)
  bedroom        String  @default("") @db.VarChar(50)
  bathroom       String  @default("") @db.VarChar(50)
  balcony        String  @default("") @db.VarChar(50)
  kitchen        String  @default("") @db.VarChar(50)
  hall           String  @default("") @db.VarChar(50)
  floor          String  @default("") @db.VarChar(100)
  size           String  @default("") @db.VarChar(100)
  price          String  @db.VarChar(100)
  /// Numeric counterpart for filtering and ordering. The display string remains
  /// authoritative for legacy presentation; null means the legacy value could
  /// not be safely parsed during the M05 backfill.
  priceValue     Decimal? @db.Decimal(14, 2)
  location       String  @db.VarChar(500)
  city           String  @db.VarChar(255)
  state          String  @db.VarChar(255)
  pimage         String  @default("") @db.VarChar(255)
  pimage1        String  @default("") @db.VarChar(255)
  pimage2        String  @default("") @db.VarChar(255)
  pimage3        String  @default("") @db.VarChar(255)
  pimage4        String  @default("") @db.VarChar(255)
  uid            Int
  status         String  @default("available") @db.VarChar(100)
  mapimage       String  @default("") @db.VarChar(255)
  topmapimage    String  @default("") @db.VarChar(255)
  groundmapimage String  @default("") @db.VarChar(255)
  totalfloor     String  @default("") @db.VarChar(100)
  isFeatured     Int     @default(0)
  offer          Int     @default(0)
  plan           String  @default("Secondary") @db.VarChar(100)
  saleid         Int     @default(0)
  decoration     String  @default("Unfurnished") @db.VarChar(100)
  curr           String  @default("AED") @db.VarChar(10)
  feature        String? @db.Text
  deactivate     Int     @default(1)
  adminapproval  Int     @default(0)
  video1         String  @default("") @db.VarChar(500)
  video2         String  @default("") @db.VarChar(500)
  video3         String  @default("") @db.VarChar(500)
  brochure       String  @default("") @db.VarChar(500)
  blocked_user   Int     @default(1)
  adminblock     Int     @default(0)
  aemail         String? @db.VarChar(255)

  // Relations
  user  User?          @relation("UserProperties", fields: [uid], references: [uid])
  admin Admin?         @relation("AdminProperties", fields: [aemail], references: [aemail])
  leads PropertyLead[]

  @@index([city])
  @@index([state])
  @@index([type])
  @@index([stype])
  @@index([deactivate, adminapproval, blocked_user, adminblock, priceValue], map: "Property_visibility_price_idx")
}

model Pin {
  id   Int    @id @default(autoincrement())
  upin String @db.VarChar(255)
}

model PropertyLead {
  id          Int      @id @default(autoincrement())
  pid         Int
  title       String   @db.VarChar(255)
  saleid      String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  nationality String   @db.VarChar(100)
  phone       String   @db.VarChar(100)
  ip          String   @db.VarChar(50)
  device      String   @db.VarChar(255)
  created_at  DateTime @default(now())

  // Relations
  property Property @relation(fields: [pid], references: [id])

  @@index([pid])
  @@index([email])
}

model DelAccount {
  id    Int      @id @default(autoincrement())
  email String   @db.VarChar(255)
  type  String   @db.VarChar(100)
  utype String   @db.VarChar(100)
  date  DateTime @default(now())

  // M04. This was a plain `@@index([email])`, which is why the admin freeze and
  // delete paths could not express "the ledger row for this address" as a single
  // unique key — they read the id with `findFirst` and then wrote an upsert against
  // `id: … ?? -1`. A read-then-upsert is not atomic: two concurrent freezes both read
  // null and both try to create, and the `?? -1` branch attempts a primary key of
  // `-1`, which only fails by luck.
  //
  // `@@unique([email])` makes `upsert({ where: { email } })` a real one-statement
  // upsert, which is what `modules/accounts` does inside the transaction.
  //
  // REQUIRES A MIGRATION on any database that already has data. Duplicate emails
  // are possible in an existing deployment — `adminUnfreezeUser` used `deleteMany`,
  // so a delete then a block could have left two rows — so run the dedupe before
  // applying:
  //
  //   DELETE d1 FROM del_account d1
  //     JOIN del_account d2
  //       ON d1.email = d2.email AND d1.id > d2.id;
  //
  // The test database is created with `prisma db push` (`scripts/test-db.js`), so it
  // picks this up with no migration step.
  @@unique([email])
  @@index([type])
}

model DeviceToken {
  id      Int    @id @default(autoincrement())
  user_id Int?
  token   String @unique @db.VarChar(500)

  user User? @relation(fields: [user_id], references: [uid])

  @@index([user_id])
}

model City {
  cid   Int    @id @default(autoincrement())
  cname String @db.VarChar(255)
  sid   Int

  state State @relation(fields: [sid], references: [sid])

  @@index([sid])
}

model State {
  sid   Int    @id @default(autoincrement())
  sname String @db.VarChar(255)

  cities City[]
}

model About {
  id      Int     @id @default(autoincrement())
  title   String? @db.VarChar(255)
  content String  @db.Text
  image   String? @db.VarChar(255)
}

model Feedback {
  fid           Int      @id @default(autoincrement())
  uid           Int?
  agid          Int?
  fdescription  String   @db.Text
  status        Int      @default(0)
  rating        Float    @default(0)
  created_at    DateTime @default(now())
  send_email    String   @db.VarChar(255)
  receive_email String   @db.VarChar(255)
  fblock        Int      @default(1)
  fdeactivate   Int      @default(1)
  fadminblock   Int      @default(0)

  // Relations
  user  User?  @relation("FeedbackFromUser", fields: [uid], references: [uid])
  admin Admin? @relation("FeedbackFromAdmin", fields: [agid], references: [aid])

  @@index([uid])
  @@index([agid])
  @@index([receive_email])
}

model TeamMember {
  id       Int     @id @default(autoincrement())
  fname    String  @db.VarChar(255)
  lname    String  @db.VarChar(255)
  email    String  @unique @db.VarChar(255)
  wnumber  String  @db.VarChar(100)
  pnumber  String  @db.VarChar(100)
  about    String  @db.Text
  type     String  @db.VarChar(100)
  fb       String? @db.VarChar(500)
  ig       String? @db.VarChar(500)
  linkdin  String? @db.VarChar(500)
  tiktok   String? @db.VarChar(500)
  twitter  String? @db.VarChar(500)
  image    String  @db.VarChar(500)
  position String  @db.VarChar(255)
}

model Contact {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(255)
  email   String @db.VarChar(255)
  phone   String @db.VarChar(100)
  subject String @db.VarChar(255)
  message String @db.Text
}

model RegisterEmail {
  id    Int    @id @default(autoincrement())
  email String @db.VarChar(255)
  name  String @db.VarChar(255)
  type  String @db.VarChar(50)
  utype String @db.VarChar(50)

  @@index([email])
  @@map("register_email")
}

model AdminSocial {
  admin_id   Int      @id
  website    String?  @db.VarChar(500)
  facebook   String?  @db.VarChar(500)
  linkedin   String?  @db.VarChar(500)
  instagram  String?  @db.VarChar(500)
  tiktok     String?  @db.VarChar(500)
  twitter    String?  @db.VarChar(500)
  updated_at DateTime @default(now())

  admin Admin @relation(fields: [admin_id], references: [aid])
}

// ============================================================
// M02 INFRASTRUCTURE
//
// Both tables exist because Redis was removed from the deployment. There is no
// second datastore to run, so the two things Redis used to hold — the job queue
// and the shared cache — are rows in the database the application already needs
// to answer any request at all. That is a deliberate trade: it costs a write per
// enqueue and a read per cache miss, and it buys a deployment with no extra
// process to supervise and no extra failure mode to diagnose.
//
// Neither table has a relation to the domain models on purpose. They are
// infrastructure that outlives any one module, and an `onDelete: Cascade` from a
// user row would delete jobs and codes nobody meant to delete.
// ============================================================

/// A queued background job. `platform/queue` is the only writer and the only
/// reader; nothing in `src/routes` touches this model.
///
/// `id` is a caller-supplied deterministic digest rather than an autoincrement,
/// which is what gives the queue BullMQ's de-duplication: a second enqueue with
/// the same id is a no-op, so a double-clicked "resend" cannot produce two
/// emails. `payload` is JSON text because a job's shape belongs to its queue's
/// processor, not to the schema.
model Job {
  id           String    @id @db.VarChar(128)
  queue        String    @db.VarChar(64)
  payload      String    @db.Text
  status       String    @default("pending") @db.VarChar(16)
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  /// Earliest time the job may run. Backoff is written here rather than slept,
  /// so a retry survives a restart instead of being lost with the process.
  run_at       DateTime  @default(now())
  /// Lease. A row left `active` with a stale `locked_at` is reclaimed by the next
  /// poller, which is how a worker killed mid-job does not strand it forever.
  locked_at    DateTime?
  locked_by    String?   @db.VarChar(64)
  last_error   String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  completed_at DateTime?

  // The claim query filters on queue + status and orders by run_at, in that
  // order, so this is the index that keeps the worker's poll off a table scan.
  @@index([queue, status, run_at])
  @@index([status, run_at])
  @@map("jobs")
}

/// The durable half of `platform/cache`.
///
/// Only namespaces listed in `CACHE_DURABLE_NAMESPACES` are written here — today
/// that is `otp`, because an OTP code and a reset token are credentials, not
/// cache: a value replica A cannot see is a registration or a password reset
/// that fails at random. Everything else stays in the in-memory layer, where a
/// stale copy across replicas is a performance fact rather than a bug.
///
/// `expires_at` is nullable rather than "always set": a null means the row does
/// not expire, and the lazy sweep deletes rows past their deadline on access, so
/// an idle process does not accumulate tombstones.
model KvEntry {
  key        String    @id @db.VarChar(255)
  value      String    @db.Text
  expires_at DateTime?
  updated_at DateTime  @updatedAt

  @@index([expires_at])
  @@map("kv_entries")
}
