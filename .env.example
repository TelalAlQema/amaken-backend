# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=amaken_realestate
MYSQL_USER=amaken
MYSQL_PASSWORD=amakenpassword

# API Configuration
DATABASE_URL="mysql://amaken:amakenpassword@localhost:3306/amaken_realestate"

# JWT Configuration
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# SMTP Configuration (Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="info@amaken-realestate.com"
SMTP_PASS="your-app-password"
SMTP_FROM="no-reply@amakenrealestate.com"

# Admin Configuration
ADMIN_MAIN_PHONE=""

# Firebase Push Notifications (optional)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Queue (M02) ─────────────────────────────────────────────────────────────
# The queue is a MySQL table, not Redis. There is no Redis to configure.
# Only the API needs QUEUE_ENABLED; the worker needs the rest.
QUEUE_ENABLED=true
# Run the worker as its own process: pnpm worker
QUEUE_PREFIX="amaken"
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=1000
# A claimed job is reclaimable once this expires. Must exceed the slowest
# processor (SMTP), or a healthy job gets run twice.
QUEUE_LEASE_MS=60000
# Attempts before a job is dead-lettered, and the first retry delay.
# Exponential thereafter, so the third attempt is ~8x further out than the first.
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
# Dead rows tolerated before the oldest are pruned. A poison job is kept on
# purpose — "the job that never works" is what an operator needs to see.
QUEUE_MAX_DEAD_JOBS=500

# ── Cache (M02) ─────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
CACHE_PREFIX="amaken"
# Namespaces written to MySQL instead of process memory. `otp` and `auth_token`
# MUST stay here: a replica-local OTP fails ~50% of registrations and reports it
# as user error, and a replica that cannot read a rotation record cannot tell a
# first refresh from a replay — refresh rotation then degrades to no rotation at
# all, on that replica, without failing.
# Durable namespaces have no in-memory copy, so a failed write means the code
# was never stored rather than served from the wrong replica.
CACHE_DURABLE_NAMESPACES="otp,auth_token"

# ── Observability ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_DEFAULT_PREFIX="amaken_api"
